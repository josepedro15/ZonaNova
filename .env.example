# =============================================================================
# ZonaNova — variáveis de ambiente
# Copiar para .env.local. Em produção, definir no painel da Vercel.
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: NUNCA expor ao cliente. Só em server actions e route handlers.
SUPABASE_SERVICE_ROLE_KEY=
# URI Postgres, para aplicar as migrations.
DIRECT_URL=

# --- UAZAPI (WhatsApp) — Fase 4 ---
UAZAPI_API_URL=
UAZAPI_ADMIN_TOKEN=
UAZAPI_WEBHOOK_SECRET=

# --- OpenAI — Fase 5 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Cifra dos tokens de instância (AES-256-GCM) ---
# Gerar com: openssl rand -base64 32
ZN_ENCRYPTION_KEY=

# --- Cron ---
CRON_SECRET=
